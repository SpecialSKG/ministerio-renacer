{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@3.2.3"
      ],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false,
      "timeout": 10000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.78",
        "--isolated",
        "--headless",
        "--block-service-workers",
        "--allowed-hosts",
        "localhost,127.0.0.1",
        "--allowed-origins",
        "http://localhost:*;http://127.0.0.1:*",
        "--output-dir",
        ".playwright-mcp",
        "--output-max-size",
        "10485760",
        "--image-responses",
        "omit"
      ],
      "enabled": false,
      "timeout": 15000
    },
    "personal": {
      "type": "local",
      "command": [
        "node",
        "tools/personal-mcp/src/index.mjs"
      ],
      "cwd": ".",
      "environment": {
        "PERSONAL_MCP_ROOT": ".",
        "PERSONAL_MCP_CONFIG": "tools/personal-mcp/config/project.example.json"
      },
      "enabled": false,
      "timeout": 10000
    }
  }
}
