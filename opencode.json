{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions/AGENTS.md",
    ".opencode/instructions/project-profile.md",
    ".opencode/instructions/security-policy.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "static-frontend": "allow",
      "json-content": "allow",
      "poc-planner": "allow",
      "poc-qa": "allow",
      "webapp-testing": "ask",
      "frontend-design": "ask",
      "web-design-guidelines": "ask",
      "seo-audit": "ask",
      "12-principles-of-animation": "ask",
      "emilkowal-animations": "ask",
      "emilkowalski-motion": "ask",
      "impeccable": "ask",
      "design-lab": "ask",
      "design-taste-frontend": "ask",
      "github-actions-docs": "ask",
      "ui-skills-root": "ask",
      "*": "deny"
    }
  },
  "plugin": ["@warp-dot-dev/opencode-warp"]
}
